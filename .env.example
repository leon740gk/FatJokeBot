# Bot token from @BotFather
FAT_JOKE_BOT_TOKEN=
# chat for the hourly "Бам!!!" and quiz questions
FAT_JOKE_MAIN_CHAT_ID=-100xxxxxxxxxx
# optional, defaults to telegram_bots/db_sqlite/my_database.db
FAT_JOKE_DB_PATH=
# optional, defaults to backups/ in the project root; a cloud-synced folder gives an off-laptop copy
FAT_JOKE_BACKUP_DIR=
# optional: minutes to answer a quiz question (default 15)
FAT_JOKE_QUIZ_ANSWER_MINUTES=15
# optional: quiz question every 20 minutes; off by default, questions only on /quiz
FAT_JOKE_QUIZ_SCHEDULE_ENABLED=false
# optional: Kyiv time hours without scheduled questions, empty = questions all night
FAT_JOKE_QUIZ_QUIET_HOURS=0-8
# optional: DEBUG also logs sticker/photo/animation file ids
FAT_JOKE_LOG_LEVEL=INFO
# optional: daily "we miss you" roll call of inactive members at 15:00 Kyiv time
FAT_JOKE_MISS_YOU_ENABLED=false
# optional: quote of the day from the /save quote book at 19:00 Kyiv time, on by default
FAT_JOKE_QUOTE_OF_THE_DAY_ENABLED=true
